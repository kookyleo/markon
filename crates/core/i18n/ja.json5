    // ── Tips — Desktop integration ───────────────────────────
    "tips.gui":        "デスクトップ連携",
    "tips.gui.1":  ".md ファイルを右クリック → プログラムから開く → Markon でブラウザプレビュー",
    "tips.gui.2":  "Markon.app を Finder ツールバーにドラッグ — アイコンをクリックで現在のフォルダをワークスペースに追加",
    "tips.gui.3":  "ワークスペースフォルダを右クリック → Markon でプレビュー",

    // ── Tips — Key features ──────────────────────────────────
    "tips.features":   "機能一覧",
    "tips.feat.search.title": "全文検索 / Search",
    "tips.feat.search.desc":  "すべてのワークスペースで全文検索が使えます。/ または g で Spotlight を開き、ファイル、タイトル、索引済み本文を検索します。",
    "tips.feat.viewed.title": "進捗マーク / Progress",
    "tips.feat.viewed.desc":  "H2–H6セクションごとの読書進捗を記録。既読をチェックすると折りたたみ、チェックを外すと未読にして展開します。個人レビューは標準機能で、Shareは共同データを選択します。",
    "tips.feat.edit.title":   "ソース編集 / Edit",
    "tips.feat.edit.desc":    "ワークスペースの編集を有効にし、e で Markdown とプレビューを開きます。Cmd/Ctrl+S で保存します。",
    "tips.feat.annot.title":  "注釈 / Annotate · Highlight · Strike · Note",
    "tips.feat.annot.desc":   "選択した文字にハイライト、取り消し線、文字注釈を付けます。Annotate は全体の機能名で、Note は文字による意見です。",
    "tips.feat.shared.title": "注釈と読書進捗の共有 / Share",
    "tips.feat.shared.desc":  "共同作業者と注釈およびセクション進捗を共有します。閲覧位置、通常の折りたたみ、Markdiff のファイル進捗は各ブラウザに残ります。",
    "tips.feat.print.title":  "印刷 / Print",
    "tips.feat.print.desc":   "主見出しからページ全体、セクション操作からその範囲を印刷します。ブラウザで PDF として保存することもできます。",
    "tips.feat.live.title":   "閲覧の提示と追従 / Live",
    "tips.feat.live.desc":    "端末間で閲覧状態を提示または追従します。l で Present / Follow を切り替え、Shift+l でオン／オフを切り替えます。",
    "tips.feat.chat.title":   "ワークスペース AI / Workspace AI · Chat",
    "tips.feat.chat.desc":    "ワークスペースのファイルについて質問し、出典を確認できます。c で Chat、Shift+c で別の表示形式を開きます。変更には Edit と承認も必要です。",
    "tips.feat.access.title": "アクセス権限 / Access",
    "tips.feat.access.desc":  "共同作業者コードでブラウザアクセスを保護します。管理者権限には `markon admin open` または `markon admin code` で作成した明示的なセッションが必要で、ネットワーク上の位置は管理権限を付与しません。",
    "tips.feat.customize.title": "カスタマイズ",
    "tips.feat.customize.desc":  "設定パネル、ビューア、エディタで共有するテーマを選び、詳細を調整；「ショートカット」で全キーを再バインド可能",

    // ── About ────────────────────────────────────────────────
    "about.slogan":   "Mark it on.",
    "about.desc":     "軽量・ローカルファーストの Markdown ワークスペース——表示・検索・注釈・チャット・デバイス間で共有。",
    "about.icon.credit": "Some icons by brajaomar_j — Flaticon",
    "about.star":     "GitHub でスターする",

