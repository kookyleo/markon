{
    "version": "0.15.25",
    "description": "Turn your markdown on. Lightweight Markdown renderer with GitHub styling.",
    "homepage": "https://github.com/kookyleo/markon",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kookyleo/markon/releases/download/v0.15.25/Markon_0.15.25_x64-setup.exe",
            "hash": "709e14c4b6ba25c82dbb08de7be7ac15aefe9349e878b1e0820f7c6b889be7d9"
        },
        "arm64": {
            "url": "https://github.com/kookyleo/markon/releases/download/v0.15.25/Markon_0.15.25_arm64-setup.exe",
            "hash": "3e629fd7532d1bf50abee5d0d6f18c67e9fdb28da1167ab879248babf27dea12"
        }
    },
    "installer": {
        "script": "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList '/S' -Wait"
    },
    "uninstaller": {
        "script": [
            "$uninst = \"$env:LocalAppData\\Programs\\Markon\\uninstall.exe\"",
            "if (Test-Path $uninst) { Start-Process $uninst -ArgumentList '/S' -Wait }"
        ]
    },
    "checkver": {
        "github": "https://github.com/kookyleo/markon",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kookyleo/markon/releases/download/v$version/Markon_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/kookyleo/markon/releases/download/v$version/Markon_$version_arm64-setup.exe"
            }
        }
    }
}
